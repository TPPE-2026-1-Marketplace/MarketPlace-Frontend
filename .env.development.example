# DK Fashion — Frontend (Desenvolvimento)
# Copiado para .env.development por `make env-setup`. Lido pelo Vite em dev
# (as VITE_* chegam ao navegador), pelo compose.dev.yml e pelos alvos selenium-local*.
# `make env-check` compara as chaves deste arquivo com o seu .env.development.

# API do backend
VITE_API_URL=http://localhost:3001/api

# Credenciais de teste locais são semeadas no backend via `make db-seed`:
#   administrador: admin@demo.com / admin123
#   gerente:       gerente@dkfashion.dev / gerente123
#   vendedor:      vendedor@dkfashion.dev / vendedor123
#   caixa:         caixa@dkfashion.dev / caixa123
#   cliente:       cliente@dkfashion.dev / cliente123

# Administrador criado pelo `make demo` ou `make db-seed` do backend.
SELENIUM_BASE_URL=http://localhost:3000
SELENIUM_ADMIN_EMAIL=admin@demo.com
SELENIUM_ADMIN_PASSWORD=admin123
SELENIUM_PROD_ADMIN_EMAIL=
SELENIUM_PROD_ADMIN_PASSWORD=

# Gerente para cenários de permissão.
SELENIUM_MANAGER_EMAIL=gerente@dkfashion.dev
SELENIUM_MANAGER_PASSWORD=gerente123
